{
  "name": "powerbridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && sh scripts/verification/release-gate.test.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --parallel --filter @platform/api --filter @platform/worker --filter @platform/web dev",
    "migration:run": "pnpm --filter @platform/api migration:run",
    "migration:show": "pnpm --filter @platform/api migration:show",
    "migration:revert": "pnpm --filter @platform/api migration:revert",
    "test:e2e": "pnpm --filter @platform/web test:e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "@types/node": "22.19.7",
    "eslint": "9.39.2",
    "typescript-eslint": "8.53.1",
    "prettier": "3.8.1",
    "globals": "17.0.0"
  }
}
