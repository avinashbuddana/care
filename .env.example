# scripts/start.sh copies this to .env on first run and fills every CHANGE_ME / replace-with value
# with a random secret. Admin login for the web app AND Superset: admin@example.com / password
# (change both before real use).

# --- App ---
# Use production + COOKIE_SECURE=true behind HTTPS on a real server.
NODE_ENV=development
# PORT is for running without Docker; Docker uses API_PORT / WEB_PORT below.
PORT=8051
API_URL=http://localhost:8051
WEB_ORIGIN=http://localhost:8050
COOKIE_SECURE=false
SESSION_HOURS=12

# --- PostgreSQL ---
# Default: Postgres runs inside Docker (service "postgres", data in the "postgres" volume).
# The three passwords below are set when that volume is FIRST created; changing them later
# does not change the database - use ALTER ROLE ... PASSWORD, or `docker compose down -v` to wipe and recreate.
# Each password must match the one in its URL. Use letters/digits only, or URL-encode (@ -> %40, # -> %23, / -> %2F).
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=CHANGE_ME_app
REPORTING_PASSWORD=CHANGE_ME_reporting
SUPERSET_DB_PASSWORD=CHANGE_ME_superset
# Host port for psql/pgAdmin on this machine (always bound to 127.0.0.1).
POSTGRES_PORT=8053
DATABASE_URL=postgresql://platform:CHANGE_ME_app@postgres:5432/platform
#
# Switching to RDS / another external Postgres later:
#   1. delete COMPOSE_PROFILES=db (the bundled postgres then no longer starts)
#   2. point DATABASE_URL, SUPERSET_METADATA_URL, REPORTING_DATABASE_URI at it
#   3. on that server, once, as superuser:
#        CREATE ROLE superset_meta LOGIN PASSWORD '...'; CREATE DATABASE superset OWNER superset_meta;
#        CREATE ROLE reporting_reader LOGIN PASSWORD '...';
#   RDS needs TLS; this pg driver verifies the cert fully, so append to DATABASE_URL:
#     ?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
#     (bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem)
#   Postgres on the Docker host itself: use host.docker.internal as the host.
DB_POOL_MAX=5
WORKER_POOL_MAX=5
QUERY_TIMEOUT_MS=300000

# --- Docker ---
# 0.0.0.0 = reachable from other machines (http://<server-name>:8050). 127.0.0.1 = this machine only.
# Opening the app by server name works without changing WEB_ORIGIN / SUPERSET_URL.
BIND_ADDR=0.0.0.0
# Host ports. The admin panel is part of the web app (WEB_PORT; pages under /admin/...).
API_PORT=8051
WEB_PORT=8050
SUPERSET_PORT=8052
# Must equal the exact URL users open in the browser (scheme + host + port), e.g.
#   WEB_ORIGIN=https://care.example.com   SUPERSET_URL=https://bi.care.example.com
# The API rejects writes whose Origin header does not match WEB_ORIGIN.

# --- Redis (BullMQ queue). Docker overrides this to its own redis container. ---
REDIS_URL=redis://localhost:6379

# --- Uploads (API and worker must see the same directory; use an absolute path) ---
STORAGE_ROOT=/srv/platform/uploads
UPLOAD_MAX_BYTES=104857600
PROFILE_SAMPLE_ROWS=1000
WORKER_CONCURRENCY=2
RETENTION_DAYS=30

# --- Secrets ---
# openssl rand -hex 32  (encrypts Bedrock keys saved in Admin -> Settings -> Bedrock; keep it safe)
SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# --- First admin login (used by: pnpm --filter @platform/api seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# --- AWS Bedrock ---
# Region + inference profile ARN are entered in Admin -> Settings -> Bedrock, not here.
# For auth mode "chain" the API reads credentials from its environment. Use ONE of:
#   (a) an attached IAM role on the server (EC2/ECS) - leave everything below commented out
#   (b) a named profile from ~/.aws/credentials
#   (c) static/temporary keys
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Superset (reporting) ---
# Metadata DB and read-only reporting user are created by the bundled postgres (see above).
SUPERSET_METADATA_URL=postgresql+psycopg2://superset_meta:CHANGE_ME_superset@postgres:5432/superset
REPORTING_DATABASE_URI=postgresql+psycopg2://reporting_reader:CHANGE_ME_reporting@postgres:5432/platform
SUPERSET_URL=http://localhost:8052
SUPERSET_SECRET_KEY=replace-with-a-different-long-random-secret
SUPERSET_ADMIN_USERNAME=admin@example.com
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=password
SUPERSET_COOKIE_SECURE=false
