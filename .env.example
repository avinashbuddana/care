# Generate unique values; this file contains no usable production credentials.
# Copy to .env on the server, then: set -a; source .env; set +a

# --- App ---
# Use production + COOKIE_SECURE=true behind HTTPS on a real server.
NODE_ENV=development
# PORT is for running without Docker; Docker uses API_PORT / WEB_PORT below.
PORT=3001
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12

# --- PostgreSQL (your own host) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Managed DB (RDS etc.) needs TLS. This pg driver verifies the cert fully, so pass the CA bundle:
#   ?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
#   (RDS bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem)
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://platform:CHANGE_ME@your-db-host.example.com:5432/platform
DB_POOL_MAX=5
WORKER_POOL_MAX=5
QUERY_TIMEOUT_MS=300000

# --- Docker ---
# Postgres on the same machine as Docker: use host.docker.internal as HOST in the URLs above/below.
# 127.0.0.1 = ports only reachable from this machine (put nginx/HTTPS in front). 0.0.0.0 = open to network.
BIND_ADDR=127.0.0.1
# Host ports. The admin panel is part of the web app (WEB_PORT, path /admin).
API_PORT=3001
WEB_PORT=3000
SUPERSET_PORT=8088
# Must equal the exact URL users open in the browser (scheme + host + port), e.g.
#   WEB_ORIGIN=https://care.example.com   SUPERSET_URL=https://bi.care.example.com
# The API rejects writes whose Origin header does not match WEB_ORIGIN.

# --- Redis (BullMQ queue). Docker overrides this to its own redis container. ---
REDIS_URL=redis://localhost:6379

# --- Uploads (API and worker must see the same directory; use an absolute path) ---
STORAGE_ROOT=/srv/platform/uploads
UPLOAD_MAX_BYTES=104857600
PROFILE_SAMPLE_ROWS=1000
WORKER_CONCURRENCY=2
RETENTION_DAYS=30

# --- Secrets ---
# openssl rand -hex 32  (encrypts Bedrock keys saved in Admin -> Settings -> Bedrock; keep it safe)
SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# --- First admin login (used by: pnpm --filter @platform/api seed) ---
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=REPLACE_WITH_12_PLUS_CHARS

# --- AWS Bedrock ---
# Region + inference profile ARN are entered in Admin -> Settings -> Bedrock, not here.
# For auth mode "chain" the API reads credentials from its environment. Use ONE of:
#   (a) an attached IAM role on the server (EC2/ECS) - leave everything below commented out
#   (b) a named profile from ~/.aws/credentials
#   (c) static/temporary keys
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Superset (reporting) ---
# Needs its own metadata database + two roles on your Postgres (one-time, as superuser):
#   CREATE ROLE superset_meta LOGIN PASSWORD '...'; CREATE DATABASE superset OWNER superset_meta;
#   CREATE ROLE reporting_reader LOGIN PASSWORD '...';   (or ALTER ROLE ... LOGIN PASSWORD if it exists)
SUPERSET_METADATA_URL=postgresql+psycopg2://superset_meta:CHANGE_ME@your-db-host.example.com:5432/superset
REPORTING_DATABASE_URI=postgresql+psycopg2://reporting_reader:CHANGE_ME@your-db-host.example.com:5432/platform
SUPERSET_URL=http://localhost:8088
SUPERSET_SECRET_KEY=replace-with-a-different-long-random-secret
SUPERSET_ADMIN_USERNAME=localadmin
SUPERSET_ADMIN_EMAIL=admin@example.test
SUPERSET_ADMIN_PASSWORD=REPLACE_ME
SUPERSET_COOKIE_SECURE=false
