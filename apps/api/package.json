{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretest": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "migration:run": "tsx src/database/migrate.ts run",
    "migration:show": "tsx src/database/migrate.ts show",
    "migration:revert": "tsx src/database/migrate.ts revert",
    "migration:create": "typeorm migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run:prod": "node dist/database/migrate.js run",
    "migration:show:prod": "node dist/database/migrate.js show",
    "seed": "tsx src/database/seed.ts",
    "cleanup": "tsx src/database/cleanup.ts",
    "seed:prod": "node dist/database/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.12",
    "@nestjs/core": "11.1.12",
    "@nestjs/platform-express": "11.1.12",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/typeorm": "11.0.0",
    "@platform/contracts": "workspace:*",
    "@platform/ingestion": "workspace:*",
    "@aws-sdk/client-bedrock-runtime": "3.975.0",
    "bullmq": "5.67.1",
    "class-validator": "0.14.3",
    "class-transformer": "0.5.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "pg": "8.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28",
    "zod": "3.25.76",
    "fflate": "0.8.2",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/multer": "2.0.0",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@nestjs/testing": "11.1.12",
    "jest": "30.2.0",
    "ts-jest": "29.4.6",
    "@types/jest": "30.0.0",
    "supertest": "7.2.2",
    "ts-node": "10.9.2"
  }
}
